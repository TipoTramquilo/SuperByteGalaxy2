---
/* Cielo de una sección.
   Las estrellas fijas y las que titilan son archivos SVG en /public/stars (el navegador los guarda en caché);
   los destellos van en línea porque usan el símbolo #spk y se apagan en móvil con CSS. */
import stars from '../data/stars.json';

interface Props {
  name: keyof typeof stars;
  /** Carga inmediata para el cielo visible al abrir la página */
  eager?: boolean;
}

const { name, eager = false } = Astro.props;
const sky = stars[name];
---
<div class="stars" style={sky.style} aria-hidden="true">
  {sky.layers.map((layer) => (
    <img class={layer} src={`/stars/${name}-${layer}.svg`} alt="" width="1440" height="900" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager && layer === 's0' ? 'high' : 'auto'} decoding="async" />
  ))}
  {sky.shines.map((group) => (
    <svg class="bs">
      {group.map((s) => (
        <g class="b" style={`--gd:${s.gd};--gdl:${s.gdl}`}><use class="sh" href="#spk" x={s.x} y={s.y}></use><circle cx={s.x} cy={s.y} r="1.3" fill={s.fill}></circle></g>
      ))}
    </svg>
  ))}
</div>
