---
/* Quiénes somos. */
import Starfield from './Starfield.astro';

const reasons = [
  {
    icon: 'network',
    title: 'Experiencia en entornos complejos',
    text: 'Trayectoria comprobada en proyectos tecnológicos estratégicos.',
  },
  {
    icon: 'blocks',
    title: 'Soluciones integrales a medida',
    text: 'Integración, desarrollo e inteligencia digital adaptada a cada organización.',
  },
  {
    icon: 'zap',
    title: 'Ejecución eficiente',
    text: 'Entrega oportuna con control de alcance, tiempos y presupuesto.',
  },
];
const delay = ['rv', 'rv d1', 'rv d2'];
---
<section class="sec" id="nosotros" aria-labelledby="h-n" style="padding-top:0">
  <Starfield name="nosotros" />
  <div class="w">
    <h2 class="kick rv" id="h-n">Quiénes somos</h2>
    <p class="state rv" style="margin-top:24px">Byte es tu socio estratégico en tecnología y transformación digital. <span class="state-sub">Unimos investigación, innovación y desarrollo para diseñar soluciones avanzadas en sistemas, aplicaciones, infraestructura y ciberseguridad. El resultado: modelos de negocio más eficientes y valor sostenible para tu organización</span></p>
    <div class="why-wrap">
      <div class="why" role="region" aria-roledescription="carrusel" aria-label="Pilares de Byte. Deslice horizontalmente o use las flechas en móvil.">
        {reasons.map((r, i) => (
          <div class={`why-slot ${delay[i % delay.length]}`}>
            <article class="why-term">
              <div class="why-bar" aria-hidden="true">
                <span class="why-dots">{[0, 1, 2].map((d) => <i class={d === i ? 'on' : undefined}></i>)}</span>
                <small>byte://{String(i + 1).padStart(2, '0')}</small>
              </div>
              <div class="why-body">
                <span class="why-ic" aria-hidden="true">
                  {r.icon === 'network' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="19" r="2.5" /><circle cx="19" cy="19" r="2.5" /><path d="M12 7.5V12m0 0L6.8 17.2M12 12l5.2 5.2" /></svg>
                  )}
                  {r.icon === 'blocks' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><path d="M17.5 14v7M14 17.5h7" /></svg>
                  )}
                  {r.icon === 'zap' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                  )}
                </span>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </div>
            </article>
          </div>
        ))}
      </div>
      <div class="why-ctrl">
        <button class="ib wnav l" type="button" aria-label="Terminal anterior" aria-disabled="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"></path></svg></button>
        <div class="why-ind">
          <span class="why-ct" aria-live="polite">01 / 03</span>
          <span class="why-pips" aria-hidden="true">{reasons.map((_, i) => <i class={i === 0 ? 'on' : undefined}></i>)}</span>
        </div>
        <button class="ib wnav r" type="button" aria-label="Siguiente terminal" aria-disabled="false"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></button>
      </div>
    </div>
  </div>
</section>
