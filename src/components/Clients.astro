---
/* Cinta de clientes. Se repite 4 veces (dos mitades idénticas) para cubrir incluso monitores ultraanchos sin huecos ni saltos al reiniciar. */
import Starfield from './Starfield.astro';
import clients from '../data/clients.json';

const loop = [0, 1, 2, 3].flatMap((pass) => clients.map((c) => ({ ...c, copy: pass > 0 })));
---
<section class="trust" aria-label="Clientes">
  <Starfield name="clientes" />
  <p>Empresas que confían en Byte</p>
  <div class="logos tint" style="--lh:34px">
    <div class="logos-in">
      {loop.map((c) => (
        <span class="lg" aria-hidden={c.copy ? 'true' : undefined}><img class="w0" src={`/logos/${c.slug}-mono.webp`} alt={c.copy ? '' : c.name} width={c.width} height="34" loading="lazy" decoding="async" /><img class="c0" src={`/logos/${c.slug}-color.webp`} alt="" aria-hidden="true" width={c.width} height="34" loading="lazy" decoding="async" /></span>
      ))}
    </div>
  </div>
</section>
