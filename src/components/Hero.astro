---
/* Hero: titular, cifras y la órbita de servicios.
   La rotación de servicios, el texto que cambia y el zoom de la B viven en src/scripts/services.ts. */
import Starfield from './Starfield.astro';
import Grain from './Grain.astro';
import services from '../data/services.json';
import site from '../data/site.json';
import { css, orbitNodes } from '../lib/geometry';

const nodes = orbitNodes(services.length);
const pad = (i: number) => String(i).padStart(2, '0');
const total = pad(services.length);
const first = services[0];
---
<section class="hero" id="inicio" aria-labelledby="h1">
  <i class="blob" style="width:520px;height:520px;right:-120px;top:-80px;background:rgba(80,54,234,.35)" aria-hidden="true"></i>
  <i class="blob" style="width:460px;height:460px;left:-160px;bottom:-200px;background:rgba(26,111,184,.40);animation-duration:32s" aria-hidden="true"></i>
  <i class="milky" aria-hidden="true"></i>
  <Starfield name="hero" eager />
  <Grain />
  <div class="w hgrid">
    <div>
      <span class="eb e1"><i aria-hidden="true"></i><span class="eb-txt">Byte Services · {site.location}</span></span>
      <h1 class="h1 e1" id="h1">Ingeniería digital de <span>nueva generación.</span></h1>
      <p class="lede e2">{site.description}</p>
      <div class="ctas e3">
        <a class="btn solid" href={site.whatsapp.url} target="_blank" rel="noopener noreferrer"><span class="cta-bg" aria-hidden="true"><i class="cta-ring"></i><i class="cta-fill"></i></span><span class="cta-lbl">Agendar consultoría</span> <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></a>
      </div>
      <dl class="nums e3" aria-label="Byte en cifras" style="margin-bottom:0">
        {site.stats.map((s) => (
          <div><dd style="margin:0"><b>{s.value}</b></dd><dt><span>{s.label}</span></dt></div>
        ))}
      </dl>
    </div>
    <div class="e4">
      <div class="orb" style="--os:600px">
        <div class="halo"></div>
        <div class="rot">
          <svg class="rings" viewBox="0 0 540 540" aria-hidden="true">
            <circle class="ring" cx="270" cy="270" r="206"></circle>
            <circle class="ring" cx="270" cy="270" r="128" style="stroke-dasharray:2 6"></circle>
            <circle class="ring" cx="270" cy="270" r="262" style="opacity:.5"></circle>
          </svg>
          {nodes.map((n, i) => <i class={i === 0 ? 'spoke on' : 'spoke'} style={css(n.spoke)} aria-hidden="true"></i>)}
          <i class="sat" style="left:98.5%;top:50%" aria-hidden="true"></i>
          <i class="sat" style="left:9%;top:24%;opacity:.5" aria-hidden="true"></i>
          {nodes.map((n, i) => (
            <div class="node" style={css(n.pos)}><div class="in"><button class={i === 0 ? 'nb on' : 'nb'} type="button" aria-label={services[i].title} title={services[i].title} aria-pressed={i === 0 ? 'true' : 'false'} data-svc={String(i)}><span class={`ic ic-${services[i].icon}`} aria-hidden="true"></span></button></div></div>
          ))}
        </div>
        <div class="core" aria-hidden="true"><Grain /><svg class="core-mark" width="859" height="913" viewBox="0 0 859 913" fill="none" aria-hidden="true"><path d="M379.33 675.058L732.539 471.338C810.553 426.352 859 342.472 859 252.429C859 208.286 847.275 164.669 825.091 126.32C780.037 48.4103 696.063 0 605.937 0H405.769C294.267 0 203.895 90.2887 203.895 201.648V559.379C203.895 564.858 207.305 569.809 212.474 571.671C215.321 572.689 218.222 573.62 221.175 574.41C231.634 577.219 242.357 578.571 253.045 578.624C265.35 578.712 281.101 576.183 293.089 571.934C298.293 570.09 301.721 565.156 301.721 559.66V201.648C301.721 144.265 348.304 97.7338 405.769 97.7338H605.937C661.222 97.7338 712.745 127.409 740.379 175.204C753.985 198.734 761.175 225.423 761.175 252.429C761.175 307.67 731.449 359.118 683.635 386.703L330.409 590.424C294.548 611.091 252.764 616.604 212.737 605.893C172.746 595.182 139.346 569.563 118.674 533.76C105.05 510.161 97.843 483.454 97.843 456.501C97.843 429.284 105.033 402.419 118.586 378.907C130.399 358.468 146.378 341.366 165.345 328.442C168.984 325.967 171.269 321.928 171.269 317.538V236.257C171.269 227.004 161.829 220.542 153.304 224.177C103.222 245.458 61.543 282.139 33.8214 330.093C11.6898 368.477 0 412.182 0 456.501C0 500.574 11.725 544.173 33.9093 582.592C67.6604 641.029 122.172 682.819 187.406 700.273C209.204 706.12 231.318 709 253.291 709C297.097 709 340.358 697.534 379.33 675.058Z" fill="#FFFFFF"/><path d="M378.973 237.576C370.193 232.507 361.185 228 352 224.04C343.484 220.378 334 226.856 334 236.151V317.196C334 321.861 336.499 326.174 340.528 328.515L523.588 434.257C527.635 436.581 532.615 436.581 536.662 434.257L608.468 392.766C617.177 387.75 617.177 375.181 608.468 370.146L378.973 237.576Z" fill="#FFFFFF"/><path d="M850.29 594.856C839.206 553.428 818.266 516.34 789.492 486.138C784.995 481.43 777.722 480.586 772.435 484.399C764.898 489.845 757.064 494.958 748.93 499.666L709.757 522.278C702.027 526.741 700.956 537.511 707.719 543.344C730.977 563.39 747.736 589.849 755.852 620.156C766.55 660.109 761.051 701.871 740.358 737.694C712.761 785.518 661.308 815.21 606.096 815.21H406.064C361.392 815.21 323.325 786.871 308.657 747.234C306.531 741.507 300.787 737.87 294.744 738.766C281.2 740.804 267.498 741.858 253.761 741.858C243.73 741.858 233.682 741.243 223.669 740.136C214.833 739.152 207.35 746.971 209.317 755.65C229.589 845.604 310.079 913 406.064 913H606.096C696.125 913 780.006 864.562 825.012 786.607C858.775 728.154 867.752 660.056 850.29 594.856Z" fill="#FFFFFF"/></svg></div>
      </div>
      <div class="cap" aria-live="polite" data-total={total}>
        <div class="capi gone" aria-hidden="true"><small>SERVICIO 01 / {total}</small><h2>{first.title}</h2><p>{first.description}</p></div>
        <div class="capi in" aria-hidden="false"><small>SERVICIO 01 / {total}</small><h2>{first.title}</h2><p>{first.description}</p></div>
      </div>
    </div>
  </div>
</section>
